# SuperNav 交通规划 systemd 服务
#
# 安装（dev 主机 root）：
#   cp deploy/supernav.service /etc/systemd/system/supernav.service
#   systemctl daemon-reload
#   systemctl enable --now supernav
#
# 更新代码后：
#   systemctl restart supernav
#
# 日志：
#   journalctl -u supernav -f
#
# 真实高德 Key（可选，不配置则为演示模式）：
#   在 /opt/supernav/config.local.json 写入 {"amap_key": "..."} 后 restart，
#   或取消下面 Environment=AMAP_KEY 的注释。Key 不要提交到仓库。

[Unit]
Description=SuperNav 交通规划
Documentation=https://wkeeli.cn/supernav/
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/supernav
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONDONTWRITEBYTECODE=1
# Environment=AMAP_KEY=你的高德 Web 服务 Key
ExecStart=/opt/supernav/.venv/bin/python -m uvicorn backend.app:app --host 0.0.0.0 --port 8091
Restart=always
RestartSec=2
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
